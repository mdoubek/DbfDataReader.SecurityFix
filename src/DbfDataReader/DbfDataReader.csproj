<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>DbfDataReader.SecurityFix is a security-fixed version of DbfDataReader with updates to resolve vulnerabilities in System.Text.RegularExpressions.</Description>
    <Copyright>Copyright Chris Richards, Security Fix by Martin Doubek</Copyright>
    <Authors>Chris Richards, Martin Doubek</Authors>
    <TargetFrameworks>net6.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>DbfDataReader.SecurityFix</AssemblyName>
    <PackageId>DbfDataReader.SecurityFix</PackageId>
    <Version>2.0.1</Version>
    <PackageTags>dbf;dBase;xBase;Clipper;FoxPro;Security;Fix;Patched;Vulnerability</PackageTags>
    <PackageProjectUrl>https://github.com/mdoubek/DbfDataReader.SecurityFix</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mdoubek/DbfDataReader.SecurityFix.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <AssemblyVersion>2.0.1.1</AssemblyVersion>
    <FileVersion>2.0.1.1</FileVersion>
	<RepositoryBranch>main</RepositoryBranch>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
</PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All" />
    <PackageReference Include="MinVer" Version="4.3.0" PrivateAssets="All" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Data.Common" Version="4.3.0" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="7.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
